# RecoveryOS environment template.
# Copy to `.env` in the repository root (git-ignored) and fill in real values.
#   macOS/Linux: cp .env.example .env        Windows: copy .env.example .env
# Never commit `.env`. The backend reads it; the browser sees only NEXT_PUBLIC_* values
# (and for Next.js those go in frontend/.env.local, see the README).

# ---------- LLM provider ----------
# groq | openrouter | none.  With "none" (or a missing key) every step uses the
# deterministic fallback, and the interface says so.
RECOVERYOS_LLM_PROVIDER=groq

# Fill in the key for the provider you chose. Leave the other blank.
GROQ_API_KEY=your-groq-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_API_KEY=your-openrouter-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Comma-separated model list, tried in order: if a model is rate limited, times out or gives
# an answer that fails the checks, the next one is tried. Use models your account offers
# (Groq lists them at GET https://api.groq.com/openai/v1/models). Example for Groq:
#   RECOVERYOS_LLM_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b,openai/gpt-oss-120b
RECOVERYOS_LLM_MODELS=model-one,model-two
RECOVERYOS_LLM_TIMEOUT_SECONDS=30
# Reasoning models spend part of this on thinking. 2000 truncated some answers in testing.
RECOVERYOS_LLM_MAX_OUTPUT_TOKENS=4000
# Hard cap on LLM calls for a single workflow run (applies per plan revision).
RECOVERYOS_LLM_MAX_CALLS_PER_RUN=20

# ---------- Database ----------
# Leave this commented out to keep runs in memory (they vanish when the backend restarts).
# For durable runs use PostgreSQL. With the Supabase CLI running locally (`supabase start`):
#   RECOVERYOS_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# For a hosted database use its session-pooler connection string. Apply the SQL files in
# supabase/migrations/ to a new Postgres database before the first start.
# RECOVERYOS_DATABASE_URL=

# Optional: a disposable Postgres database for the integration tests (same format).
# RECOVERYOS_TEST_DATABASE_URL=

# ---------- Backend ----------
# Comma-separated browser origins allowed to call the API. Add the deployed site origin.
RECOVERYOS_CORS_ORIGINS=http://localhost:3000
RECOVERYOS_MAX_REQUEST_BYTES=1000000
RECOVERYOS_RATE_LIMIT_PER_MINUTE=120
RECOVERYOS_MAX_CONCURRENT_RUNS=5

# ---------- Workflow safety ----------
# Demo mode: failure injection is allowed. Turn it off for a public deployment.
RECOVERYOS_DEMO_MODE=true
# Real GitHub writes are not implemented in this build. This flag must stay false:
# publishing is always simulated, and a plan can be downloaded to publish yourself.
RECOVERYOS_ENABLE_REAL_GITHUB_WRITES=false

# Let users link a public GitHub repository (read-only: commits, tags, CI checks).
# Turn this off on a public deployment if you do not want strangers using your GitHub quota.
RECOVERYOS_ENABLE_GITHUB_LINK=true
# Optional, server-side only, read access to public repositories (no scopes needed).
# Leave empty to read anonymously (GitHub allows about 60 requests per hour per server IP).
# It is never sent to the browser, stored in run state, or written to logs.
GITHUB_TOKEN=

# Minutes an approval stays valid.
RECOVERYOS_APPROVAL_TTL_MINUTES=60
# Attempts per step before a retryable failure ends the run.
RECOVERYOS_MAX_STEP_ATTEMPTS=3

# ---------- Frontend (Next.js) ----------
# Set in frontend/.env.local (Next.js does not read the root .env). Only the public API URL
# belongs here, never a secret.
# NEXT_PUBLIC_API_URL=http://localhost:8000
